# Manual single-transaction prediction API (POST, JSON body, all 19 fields).
# Defaults to the deployed service below if unset.
VITE_API_URL=https://bank-fraud-manual.onrender.com/api/predict

# CSV batch-analysis API (POST, multipart/form-data, field name "file").
# Defaults to the deployed service below if unset. This is a different
# deployment from VITE_API_URL above — do not point both at the same URL.
VITE_UPLOAD_API_URL=https://bank-fraud-render.onrender.com/api/predict
